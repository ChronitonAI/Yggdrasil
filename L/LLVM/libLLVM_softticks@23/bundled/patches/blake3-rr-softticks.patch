diff --git a/llvm/lib/Support/BLAKE3/llvm_blake3_softticks.h b/llvm/lib/Support/BLAKE3/llvm_blake3_softticks.h
new file mode 100644
index 000000000..00f847e91
--- /dev/null
+++ b/llvm/lib/Support/BLAKE3/llvm_blake3_softticks.h
@@ -0,0 +1,40 @@
+#ifndef LLVM_BLAKE3_SOFTTICKS_H
+#define LLVM_BLAKE3_SOFTTICKS_H
+
+/* rr software ticks for the x86-64 assembly (the *_x86-64_unix.S files). A program built
+   with a software-ticks compiler pass counts its own progress instead of relying on the
+   CPU's branch counter: the pass ticks compiled code at every function entry and loop
+   header, so that no instruction runs twice in the same stack frame without a tick in
+   between. The assembly ticks the same way through BLAKE3_SOFTTICK: at every function
+   entry (after _CET_ENDBR) and at the head of every loop (each label that a backward
+   branch targets and that a cycle passes through; the functions' shared epilogues, which
+   tail paths reach by backward jumps, are in no cycle and do not tick). The compiler's
+   plugin predefines __RR_SOFTTICKS__ (the ABI version), also for .S files; without it
+   BLAKE3_SOFTTICK is empty and the object code is unchanged.
+
+   The sequence is ABI version 1's x86-64 tick (RR_SOFTTICKS_X64_TICK_ASM in rr's
+   softticks.h), byte for byte: while the countdown is armed (its top bit clear) it
+   decrements it, trapping at 0. It clobbers the flags only, which no site reads before
+   writing them. The files are in Intel syntax, so it switches to AT&T syntax for the
+   sequence and back. Its end label is 7731, not the ABI string's 1, which would capture a
+   loop's `jcc 1b`; the files define no label 7731.
+
+   The Windows variants (*_windows_gnu.S, *_windows_msvc.asm) are not ticked: rr runs on
+   Linux only. */
+#if defined(__RR_SOFTTICKS__)
+#if __RR_SOFTTICKS__ != 1
+#error "BLAKE3: unsupported software-ticks ABI version"
+#endif
+#define BLAKE3_SOFTTICK                                                        \
+  .att_syntax prefix;                                                          \
+  testb $0x80, 0x70001807;                                                     \
+  jnz 7731f;                                                                   \
+  decq 0x70001800;                                                             \
+  jnz 7731f;                                                                   \
+  int3;                                                                        \
+  7731: .intel_syntax noprefix
+#else
+#define BLAKE3_SOFTTICK
+#endif
+
+#endif /* LLVM_BLAKE3_SOFTTICKS_H */
