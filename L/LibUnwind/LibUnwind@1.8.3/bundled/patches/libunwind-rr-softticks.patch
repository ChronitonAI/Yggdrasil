diff --git a/src/x86_64/softticks_i.h b/src/x86_64/softticks_i.h
new file mode 100644
index 0000000..efb3158
--- /dev/null
+++ b/src/x86_64/softticks_i.h
@@ -0,0 +1,32 @@
+/* rr software ticks for the x86-64 assembly (getcontext.S, setcontext.S,
+   longjmp.S, siglongjmp.S).
+
+   A program built with a software-ticks compiler pass counts its own progress
+   instead of relying on the CPU's branch counter: the pass ticks compiled code
+   at every function entry and loop header, so that no instruction runs twice
+   in the same stack frame without a tick in between. These functions have no
+   loops, but each is a function that a frame can call more than once, so each
+   ticks at its entry (UNW_SOFTTICK) as compiled code does. The compiler's
+   plugin predefines __RR_SOFTTICKS__ (the ABI version), also for .S files;
+   without it UNW_SOFTTICK is empty and the object code is unchanged.
+
+   The sequence is ABI version 1's x86-64 tick (RR_SOFTTICKS_X64_TICK_ASM in
+   rr's softticks.h), byte for byte. It clobbers the flags only, which no
+   function here reads before writing them, and neither getcontext nor
+   setcontext saves or restores them on Linux. Its end label is 7731, not the
+   ABI string's 1, which a file's own `1:` labels could collide with.  */
+
+#ifndef UNW_X86_64_SOFTTICKS_I_H
+#define UNW_X86_64_SOFTTICKS_I_H
+
+#if defined(__RR_SOFTTICKS__)
+# if __RR_SOFTTICKS__ != 1
+#  error "libunwind: unsupported software-ticks ABI version"
+# endif
+# define UNW_SOFTTICK \
+	testb $0x80, 0x70001807; jnz 7731f; decq 0x70001800; jnz 7731f; int3; 7731:
+#else
+# define UNW_SOFTTICK
+#endif
+
+#endif /* UNW_X86_64_SOFTTICKS_I_H */
