+    # Per section, the items in order; the next instruction an item falls into.
+    my (%order, @pos);
+    for my $i (0 .. $n - 1) { push @{$order{$sec[$i]}}, $i; $pos[$i] = $#{$order{$sec[$i]}}; }
+    my @at;	# item -> the instruction it falls into (-1: data or the end)
+    for my $s (keys %order) {
