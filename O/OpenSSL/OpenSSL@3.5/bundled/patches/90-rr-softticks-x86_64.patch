+my $sym = qr/[A-Za-z_.\$][\w.\$]*/;
+
+# Directives that emit nothing into a code path (alignment emits padding,
+# which falls through).
+my $nocode = qr/^(?:cfi_\w+|type|size|globl|global|hidden|protected|weak|extern|comm|lcomm|local|file|ident|align|p2align|balign|set|equ|loc|text|section|previous|pushsection|popsection)$/;
+
+sub split_ops {
+    my ($o) = @_;
+    my @r;
+    my ($d, $cur) = (0, "");
+    for my $ch (split(//, $o)) {
+	if ($ch eq "," && !$d) { push @r, $cur; $cur = ""; next; }
+	$d++ if ($ch eq "(");
+	$d-- if ($ch eq ")");
+	$cur .= $ch;
+    }
+    push @r, $cur if ($cur ne "");
+    s/^\s+|\s+$//g for @r;
+    return @r;
+}
+
+# General-purpose registers, by their 64-bit names; and their other names.
+my @gpr = qw(rax rbx rcx rdx rsi rdi rbp r8 r9 r10 r11 r12 r13 r14 r15);
+my (%gpr_of, %whole);
+{
+    my %low = (rax=>[qw(eax ax al ah)], rbx=>[qw(ebx bx bl bh)], rcx=>[qw(ecx cx cl ch)],
+	       rdx=>[qw(edx dx dl dh)], rsi=>[qw(esi si sil)], rdi=>[qw(edi di dil)],
+	       rbp=>[qw(ebp bp bpl)], rsp=>[qw(esp sp spl)]);
+    for my $r (@gpr, "rsp") {
+	$gpr_of{$r} = $whole{$r} = $r;
+	if ($r =~ /^r\d+$/) { $gpr_of{"$r$_"} = $r for ("d", "w", "b"); $whole{"${r}d"} = $r; }
+	else { $gpr_of{$_} = $r for (@{$low{$r}}); $whole{$low{$r}->[0]} = $r; }
+    }
+}
+my %byte_name = (rax=>"al", rbx=>"bl", rcx=>"cl", rdx=>"dl", rsi=>"sil", rdi=>"dil",
+		 rbp=>"bpl", map { ("r$_" => "r${_}b") } 8 .. 15);
+
+# The general-purpose registers an instruction reads, and those it writes
+# whole (64 or 32 bits) without reading them, as ({name => 1}, {name => 1});
+# () if this does not know it. A register written in part counts as read.
+sub insn_regs {
+    my ($m, $o) = @_;
+    my @ops = split_ops($o);
+    my (%rd, %wr);
+    my $reads = sub {
+	for my $t (@_) { while ($t =~ /%(\w+)/g) { $rd{$gpr_of{$1}} = 1 if (exists($gpr_of{$1})); } }
+    };
+    my $write = sub {	# a whole write of a register operand, else a read
+	my $t = shift;
+	if ($t =~ /^%(\w+)$/ && exists($whole{$1})) { $wr{$whole{$1}} = 1; } else { $reads->($t); }
+    };
+    my $done = sub { delete $wr{$_} for (keys %rd); return (\%rd, \%wr); };
+    return () if (grep { /%(?:[cdefgs]s|st|cr|dr)\b/ } @ops);
+    if ($m =~ /^(?:mov[bwlq]?|movabsq|movz[bw][wlq]?|movs[bw][wlq]|movs?lq|lea[wlq]?|v?mov[dq])$/ && @ops == 2) {
+	$reads->($ops[0]);
+	$write->($ops[1]);
+	return $done->();
+    }
+    if ($m =~ /^(?:xor|sub)[lq]$/ && @ops == 2 && $ops[0] eq $ops[1] && $ops[1] =~ /^%(\w+)$/ && exists($whole{$1})) {
+	$wr{$whole{$1}} = 1;
+	return $done->();
+    }
+    if ($m =~ /^pop[q]?$/ && @ops == 1) { $rd{rsp} = 1; $write->($ops[0]); return $done->(); }
+    if ($m =~ /^push[q]?$/ && @ops == 1) { $rd{rsp} = 1; $reads->($ops[0]); return $done->(); }
+    if ($m =~ /^(?:mulx|rorx|shlx|shrx|sarx|andn|bzhi|bextr|pdep|pext)[lq]?$/ && @ops == 3) {
+	$reads->($ops[0]);
+	$rd{rdx} = 1 if ($m =~ /^mulx/);
+	if ($m =~ /^mulx/) { $write->($ops[1]); } else { $reads->($ops[1]); }
+	$write->($ops[2]);
+	return $done->();
+    }
+    if ($m =~ /^imul[wlq]?$/ && @ops == 3) { $reads->(@ops[0, 1]); $write->($ops[2]); return $done->(); }
+    if ($m =~ /^(?:mul|imul|div|idiv)[lq]$/ && @ops == 1) {
+	$reads->($ops[0]);
+	$rd{rax} = 1;
+	$rd{rdx} = 1 if ($m =~ /div/);
+	$wr{rax} = $wr{rdx} = 1;
+	return $done->();
+    }
+    if ($m =~ /^(?:add|adc|sub|sbb|and|or|xor|adcx|adox|cmp|test|neg|not|inc|dec|shl|shr|sal|sar|rol|ror|rcl|rcr|shld|shrd|imul|bt|bts|btr|btc|bswap|xchg|xadd|cmov\w+|set\w+|popcnt|lzcnt|tzcnt|bsf|bsr)[bwlq]?$/ &&
+	@ops >= 1 && @ops <= 3) {
+	$reads->(@ops);
+	$rd{rcx} = 1 if ($m =~ /^(?:shl|shr|sal|sar|rol|ror|rcl|rcr|shld|shrd)/ && $o =~ /%cl\b/);
+	return $done->();
+    }
+    return $done->() if (@ops == 0 && $m =~ /^(?:nop|vzeroupper|vzeroall|lfence|mfence|sfence|int3|endbr64)$/);
+    if ($m =~ /^(?:prefetch\w*|clflush)$/ && @ops == 1) { $reads->($ops[0]); return $done->(); }
+    # SIMD: GPR operands count as read (as do those in addresses)
+    if ($m =~ /^(?:v\w+|p(?!ush|op)\w+|aes\w+|sha\w+|movdq\w|mov[au]p[sd]|movhlps|movlhps|shufp[sd]|unpck\w+|xorp[sd]|andn?p[sd]|orp[sd]|k\w+)$/ &&
+	$m !~ /^(?:pcmp[ei]str\w|vpcmp[ei]str\w|vmaskmov\w+|maskmov\w+)$/) {
+	$reads->(@ops);
+	return $done->();
+    }
+    return ();
+}
