+
+# The instructions encoded in bytes, as one: (control, flags read, flags
+# written), or () if this does not know them all. Only the last may be a
+# control transfer; a prefix alone is one of the next instruction.
+sub bytes_flags {
+    my @b = @_;
+    my @ins;
+    my $i = 0;
+    while ($i < @b) {
+	my @d = decode_one(\@b, $i);
+	return () if (!@d || $d[0] <= 0);
+	push @ins, [@d[1 .. 3]];
+	$i += $d[0];
+    }
+    return @{$ins[0]} if (@ins == 1);
+    my ($rd, $wr) = (0, 0);
+    for my $k (0 .. $#ins) {
+	my ($c, $r, $w) = @{$ins[$k]};
+	return () if ($c eq "prefix" || $c ne "n" && $c ne "endbr" && $k < $#ins);
+	$rd |= $r & ~$wr;
+	$wr |= $w;
+    }
+    my $c = $ins[-1][0];
+    return ($c eq "endbr" ? "n" : $c, $rd, $wr);
+}
+
+sub tick_asm {
+    my ($l) = @_;
+    return "\ttestb\t\$0x80,0x70001807\n\tjnz\t$l\n\tdecq\t0x70001800\n\tjnz\t$l\n\tint3\n$l:";
+}
+
+# RR_SOFTTICKS_X64_INIT_ASM: the initializer, its .init_array entry and the note.
+my $INIT_ASM = <<'___';
+	.pushsection .text.__rr_softticks_init,"axG",@progbits,__rr_softticks_init,comdat
+	.weak __rr_softticks_init
+	.hidden __rr_softticks_init
+	.type __rr_softticks_init,%function
+	.p2align 4
+__rr_softticks_init:
+	movl $9, %eax
+	movl $0x70001000, %edi
+	movl $4096, %esi
+	movl $3, %edx
+	movl $0x100022, %r10d
+	movq $-1, %r8
+	xorl %r9d, %r9d
+	syscall
+	cmpq $0x70001000, %rax
+	je 1f
+	cmpq $-4095, %rax
+	jae 1f
+	movq %rax, %rdi
+	movl $11, %eax
+	movl $4096, %esi
+	syscall
+1:	ret
+	.size __rr_softticks_init,.-__rr_softticks_init
+	.section .init_array.00001,"awG",@init_array,__rr_softticks_init,comdat
+	.p2align 3
+	.quad __rr_softticks_init
+	.section .note.rrsoftticks,"aG",@note,__rr_softticks_init,comdat
+	.p2align 2
+	.long 3
+	.long 4
+	.long 1
+	.asciz "rr"
+	.p2align 2
+	.long 1
+	.popsection
