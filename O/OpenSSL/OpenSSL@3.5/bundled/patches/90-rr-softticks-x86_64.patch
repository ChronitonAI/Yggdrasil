+sub softticks_insert {
+    my ($text, $name) = @_;
+    my $err = sub { die "x86_64-softticks.pl: $name: $_[0]\n"; };
+    my @lines = split(/\n/, $text, -1);
+
+    # Items: labels and statements, with their line and section.
+    my (@kind, @lab, @mn, @op, @sec, @iline, %def);
+    my ($cur, $prev) = (".text", ".text");
+    my @stack;
+    for my $li (0 .. $#lines) {
+	my $s = $lines[$li];
+	next if ($s =~ /^\s*#/);
+	$s =~ s/\s+#.*$// if ($s !~ /["']/);
+	while ($s =~ s/^\s*($sym|\d+):(?!:)//) {
+	    my $l = $1;
+	    push @kind, "L"; push @lab, $l; push @mn, undef; push @op, undef;
+	    push @sec, $cur; push @iline, $li;
+	    if ($l =~ /^\d+$/) { $err->("numeric label $l in code") if ($cur =~ /^\.(?:text|init|fini)\b/); next; }
+	    $err->("label $l defined twice") if (exists($def{$l}));
+	    $def{$l} = $#kind;
+	}
+	$s =~ s/^\s+|\s+$//g;
+	next if ($s eq "");
+	if ($s =~ /^\.(\w+)\s*(.*)$/) {
+	    my ($d, $a) = ($1, $2);
+	    if ($d =~ /^(?:text|data|bss)$/) { ($prev, $cur) = ($cur, ".$d"); }
+	    elsif ($d eq "section") { $a =~ /^"?([^",\s]+)/; ($prev, $cur) = ($cur, $1); }
+	    elsif ($d eq "previous") { ($prev, $cur) = ($cur, $prev); }
+	    elsif ($d eq "pushsection") { push @stack, [$cur, $prev]; $a =~ /^"?([^",\s]+)/; ($prev, $cur) = ($cur, $1); }
+	    elsif ($d eq "popsection") { ($cur, $prev) = @{pop(@stack)}; }
+	    push @kind, "D"; push @lab, undef; push @mn, $d; push @op, $a;
+	} else {
+	    my @w = split(/\s+/, $s, 2);
+	    my ($m, $o) = ($w[0], $w[1] // "");
+	    push @kind, "I"; push @lab, undef; push @mn, $m; push @op, $o;
+	}
+	push @sec, $cur; push @iline, $li;
+    }
+    my $n = scalar(@kind);
+    my $code = sub { $_[0] =~ /^\.(?:text|init|fini)\b/ };
+
+    # Instructions: control, flags.
+    my (@ctl, @rd, @wr, @tgt, @bytes);
+    my (%func, %glob);
+    for my $i (0 .. $n - 1) {
+	if ($kind[$i] eq "D") {
+	    if ($mn[$i] eq "type" && $op[$i] =~ /^($sym)\s*,\s*[\@%]function/) { $func{$1} = 1; }
+	    elsif ($mn[$i] =~ /^glob(?:a)?l$/) { $glob{$_} = 1 for (split(/\s*,\s*/, $op[$i])); }
+	    elsif ($mn[$i] =~ /^(?:byte|value|word|long)$/ && $code->($sec[$i])) {
+		# instructions encoded as data
+		my $sz = $mn[$i] eq "byte" ? 1 : $mn[$i] eq "long" ? 4 : 2;
+		my @v = map { /^0x[0-9a-f]+$/i ? hex($_) : /^\d+$/ ? $_ + 0 : -1 } split(/\s*,\s*/, $op[$i]);
+		next if (grep({ $_ < 0 || $_ >= 256 ** $sz } @v) || @v * $sz > 15);
+		my @b = map { my $v = $_; map { ($v >> (8 * $_)) & 255 } 0 .. $sz - 1 } @v;
+		my @f = bytes_flags(@b);
+		if (@f) { $kind[$i] = "I"; ($ctl[$i], $rd[$i], $wr[$i]) = @f; $bytes[$i] = \@b; }
+	    }
+	    next;
+	}
+	next if ($kind[$i] ne "I");
+	my ($m, $o) = ($mn[$i], $op[$i]);
+	my $rep = 0;
+	while ($m =~ /^\{\w+\}$/ || $m =~ /^(?:rep|repe|repz|repne|repnz|lock|notrack|bnd|data16|addr32)$/) {
+	    $rep = 1 if ($m =~ /^rep/);
+	    $err->("prefix without instruction: $m") if ($o eq "");
+	    ($m, $o) = split(/\s+/, $o, 2); $o //= "";
+	}
+	($mn[$i], $op[$i]) = ($m, $o);
+	my @f = insn_flags($m, $o);
+	if (!@f) {
+	    $err->("unknown instruction: $m $o") if ($code->($sec[$i]));
+	    @f = ("n", $ALL, 0);
+	}
+	@f[1, 2] = (0, 0) if ($rep && $m =~ /^(?:cmps|scas)/);
+	($ctl[$i], $rd[$i], $wr[$i]) = @f;
+	if ($f[0] =~ /^(?:jmp|jcc|call)$/) {
+	    if ($o =~ /^\*/) {
+		$err->("indirect jump: $m $o") if ($f[0] ne "call");
+	    } elsif ($o =~ /^($sym)$/) {
+		$tgt[$i] = $1;
+	    } else {
+		$err->("jump to an expression: $m $o");
+	    }
+	}
+    }
