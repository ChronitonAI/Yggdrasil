+	    $at[$k] = $nx;
+	}
+    }
+    my $next = sub {	# the instruction after instruction i in its section
+	my $i = shift;
+	my $l = $order{$sec[$i]};
+	return $pos[$i] < $#$l ? $at[$l->[$pos[$i] + 1]] : -1;
+    };
+
+    # Successors for the flags' liveness (backward, to a fixpoint). -1 is
+    # data, or the end of a section: all flags live. A call's successor is
+    # the callee's entry when it is here, and nothing may read the flags it
+    # returns (checked below); a jump out of the file is a tail call.
+    my (@succ, @pred);
+    my @ins = grep { $kind[$_] eq "I" && $code->($sec[$_]) } 0 .. $n - 1;
+    for my $i (@ins) {
+	my $c = $ctl[$i];
+	my $t = $tgt[$i];
+	my $local = defined($t) && exists($def{$t});
+	$err->("jump from $sec[$i] to $sec[$def{$t}]: $mn[$i] $t") if ($local && $sec[$def{$t}] ne $sec[$i]);
+	my @s;
+	if ($c eq "ret" || $c eq "stop") { }
+	elsif ($c eq "jmp") { push @s, $at[$def{$t}] if ($local); }
+	elsif ($c eq "jcc") { push @s, $next->($i); push @s, $at[$def{$t}] if ($local); }
+	elsif ($c eq "call" && $local) { push @s, $at[$def{$t}]; $wr[$i] = 0; }
+	else { push @s, $next->($i); }
+	if (grep { $_ < 0 } @s) {
+	    # Only an .init or .fini fragment may fall off its end (into the
+	    # next object's); anything else falls or jumps into data.
+	    my $l = $order{$sec[$i]};
+	    my $rest = grep { $kind[$_] eq "I" || $kind[$_] eq "D" && $mn[$_] !~ $nocode } @$l[$pos[$i] + 1 .. $#$l];
+	    $err->("$mn[$i] $op[$i] goes into data (or bytes this does not know)")
+		if ($sec[$i] !~ /^\.(?:init|fini)\b/ || $rest || $next->($i) >= 0 || grep({ $_ < 0 } @s) > 1 ||
+		    $c eq "jmp" || $c eq "jcc" && $local && $at[$def{$t}] < 0);
+	}
+	$succ[$i] = \@s;
+	push @{$pred[$_]}, $i for (grep { $_ >= 0 } @s);
+    }
+    # The instructions that start a block (a label precedes them).
+    my %blockstart;
+    for my $i (0 .. $n - 1) { $blockstart{$at[$i]} = 1 if ($kind[$i] eq "L" && $at[$i] >= 0); }
+
+    # pushf reads every flag, as it saves them on the stack. But where popf
+    # takes them back later in its block, with the stack pointer and the
+    # word (%rsp) left alone in between, they are as before the pushf (and
+    # nothing may read them after the popf: checked below), and so pushf
+    # reads none. Nor in the PadLock pattern, before a call of a function
+    # that reads the word only with "bt $30" (_padlock_verify_ctx: bit 30
+    # of the flags, VIA's key-reload flag, is not one that a tick writes);
+    # the caller pops it with popf (as above) or drops it.
+    my $stack = sub {	# does instruction j move %rsp or touch the word at (%rsp)?
+	my $j = shift;
+	if ($mn[$j] =~ /^(?:byte|value|word|long)$/) {	# by its opcode: push, pop, pushf, popf, leave, call, ret, group 5
+	    my ($b, $k) = ($bytes[$j], 0);
+	    $k++ while ($k < @$b && ($legacy_prefix{$b->[$k]} || $b->[$k] >= 0x40 && $b->[$k] <= 0x4f));
+	    my $o = $b->[$k] // -1;
+	    return $o >= 0x50 && $o <= 0x5f || $o == 0x8f || $o == 0x9c || $o == 0x9d || $o == 0xc9 ||
+		   $o == 0xc2 || $o == 0xc3 || $o == 0xe8 || $o == 0xff || $o < 0;
+	}
+	return $mn[$j] =~ /^(?:push|pop|call|ret|leave|enter)/ || $op[$j] =~ /(?:^|,)\s*0?\(%rsp\)|,\s*%[re]?sp\s*$/ ||
+	       $mn[$j] =~ /^xchg/ && $op[$j] =~ /%[re]?sp\b/;
+    };
+    my $bit30 = sub {	# does the function at instruction e read 8(%rsp) only with "bt $30"?
+	my $e = shift;
+	return 0 if ($e < 0 || $mn[$e] !~ /^movq?$/ || $op[$e] !~ /^8\(%rsp\),\s*%(r\w+)$/ || !exists($gpr_of{$1}));
+	my $r = $gpr_of{$1};
+	my $b = $next->($e);
+	return 0 if ($b < 0 || $mn[$b] !~ /^btq?$/ || $op[$b] !~ /^\$30,\s*%(\w+)$/ || ($gpr_of{$1} // "") ne $r);
+	my @jcc;	# its branches must stay before its ret
+	for (my $j = $next->($b); ; $j = $next->($j)) {
+	    return 0 if ($j < 0 || $op[$j] =~ /\(%rsp\)/);
+	    while ($op[$j] =~ /%(\w+)/g) { return 0 if (($gpr_of{$1} // "") eq $r); }
+	    if ($ctl[$j] eq "ret") {
+		return !grep { !defined($tgt[$_]) || !exists($def{$tgt[$_]}) || $at[$def{$tgt[$_]}] < 0 ||
+			       $sec[$at[$def{$tgt[$_]}]] ne $sec[$j] || $pos[$at[$def{$tgt[$_]}]] > $pos[$j] ||
+			       $pos[$at[$def{$tgt[$_]}]] < $pos[$e] } @jcc;
+	    }
+	    return 0 if ($ctl[$j] eq "call" || $ctl[$j] eq "jmp" || $ctl[$j] eq "stop");
+	    push @jcc, $j if ($ctl[$j] eq "jcc");
+	}
+    };
+    for my $i (@ins) {
+	next if ($mn[$i] !~ /^pushf[wlq]?$/);
+	for (my $j = $next->($i); $j >= 0 && !$blockstart{$j}; $j = $next->($j)) {
+	    if ($mn[$j] =~ /^popf[wlq]?$/) { $rd[$i] = 0; last; }
+	    if ($ctl[$j] eq "call" && defined($tgt[$j]) && exists($def{$tgt[$j]}) && $bit30->($at[$def{$tgt[$j]}])) { $rd[$i] = 0; last; }
+	    last if ($ctl[$j] ne "n" || $stack->($j));
+	}
+    }
+
+    my @live;	# live in
+    my @work = reverse @ins;
+    my %inwork = map { $_ => 1 } @ins;
+    while (@work) {
+	my $i = pop @work;
+	delete $inwork{$i};
+	my $out = 0;
+	for my $s (@{$succ[$i]}) { $out |= $s < 0 ? $ALL : ($live[$s] // 0); }
+	my $in = $rd[$i] | ($out & ~$wr[$i]);
+	next if (defined($live[$i]) && $live[$i] == $in);
+	$live[$i] = $in;
+	for my $p (@{$pred[$i] // []}) { push @work, $p if (!$inwork{$p}++); }
+    }
+    for my $i (@ins) {
+	# The flags a callee returns, and those that popf restores, are dead.
+	next if ($ctl[$i] ne "call" && $mn[$i] !~ /^popf/);
+	my $nx = $next->($i);
+	$err->("flags read after $mn[$i] $op[$i]") if ($nx >= 0 && $live[$nx]);
+    }
+
+    # The tick sites: function entries and the targets of backward jumps.
+    my %site;	# label item -> why
+    for my $i (@ins) {
+	next if ($ctl[$i] !~ /^(?:jmp|jcc|call)$/ || !defined($tgt[$i]) || !exists($def{$tgt[$i]}));
+	my $d = $def{$tgt[$i]};
+	if ($ctl[$i] eq "call") { $site{$d} //= "entry"; }
+	elsif ($pos[$d] <= $pos[$i]) { $site{$d} = "loop"; }
+    }
+    for my $f (keys %func, keys %glob) {
+	next if (!exists($def{$f}) || !$code->($sec[$def{$f}]));
+	$site{$def{$f}} //= "entry";
+    }
+    for my $d (keys %site) {	# exported functions must not read the flags
+	my $s = $at[$d];
+	$err->("tick site $lab[$d] is no code") if ($s < 0);
+	$err->("$lab[$d] reads the flags at its entry") if ($glob{$lab[$d]} && $live[$s]);
+    }
+
+    # Per site, the place in its block (before instruction k), and the
+    # registers that keep the flags live there.
+    my %regs;	# instruction -> [read, written] or []
+    my $dead = sub {	# the registers dead before instruction k
+	my $k = shift;
+	my %fate;	# register -> 0 (read first) or 1 (written first)
+	for (my $j = $k; $j >= 0; ) {
+	    last if ($ctl[$j] eq "call" || $ctl[$j] eq "prefix");
+	    $regs{$j} //= [$mn[$j] !~ /^(?:byte|value|word|long)$/ ? insn_regs($mn[$j], $op[$j]) : ()];
+	    last if (!@{$regs{$j}});
+	    my ($r, $w) = @{$regs{$j}};
+	    for my $g (@gpr) { $fate{$g} //= 0 if ($r->{$g}); $fate{$g} //= 1 if ($w->{$g}); }
+	    $fate{rcx} //= 0 if ($mn[$j] =~ /^(?:j[er]?cxz|loop\w*)$/);
+	    last if ($ctl[$j] ne "n");
+	    $j = $next->($j);
+	    last if ($j >= 0 && $blockstart{$j});
+	}
+	return grep { $fate{$_} } @gpr;
+    };
+    my (%tick_at, @report);
+    for my $d (sort { $a <=> $b } keys %site) {
+	my $k = $at[$d];
+	$k = $next->($k) if ($ctl[$k] eq "endbr");
+	$err->("tick site $lab[$d] has no instruction") if ($k < 0);
+	my ($best, $bc, $bkeep, $prevk) = (-1, 99, undef, -1);
+	for (my $j = $k; $j >= 0; ) {
+	    if (!($prevk >= 0 && $ctl[$prevk] eq "prefix")) {
+		my $l = $live[$j];
+		my ($c, @keep) = (0);
+		if ($l & ~($C | $O)) { $c = 99; }
+		elsif ($l) {
+		    my @r = $dead->($j);
+		    my $f = $l == ($C | $O) ? 2 : 1;
+		    if (@r >= $f) { @keep = map { "%" . $byte_name{$_} } @r[0 .. $f - 1]; $c = $l == $C ? 1 : $l == $O ? 2 : 3; }
+		    else { $c = 99; }
+		}
+		($best, $bc, $bkeep) = ($j, $c, \@keep) if ($c < $bc);
+		last if ($c == 0);
+	    }
+	    last if ($ctl[$j] ne "n" && $ctl[$j] ne "call" && $ctl[$j] ne "prefix");
+	    ($prevk, $j) = ($j, $next->($j));
+	    last if ($j >= 0 && $blockstart{$j});
+	}
+	$err->("no place for the tick at $lab[$d]: flags live everywhere in its block, and no dead register") if ($best < 0);
+	my $l = $live[$best];
+	push @report, sprintf("%s %s %s live=%s keep=%s moved=%d", $name, $site{$d}, $lab[$d],
+			      join("", map { $l & $_->[0] ? $_->[1] : "" } ([$C,"C"],[$O,"O"])),
+			      join(",", @$bkeep), $best != $k ? 1 : 0);
+	$tick_at{$best} //= [$l, $bkeep];
+    }
+    # The first instruction of each .init section calls the initializer.
+    my %init_call;
+    for my $i (0 .. $n - 1) {
+	next if ($kind[$i] ne "D" || $mn[$i] !~ /^(?:section|pushsection)$/ || $sec[$i] ne ".init");
+	$init_call{$at[$i]} = 1 if ($at[$i] >= 0);
+    }
+
+    # The output.
+    my %before;	# line -> [items with a tick before them]
+    for my $k (keys %tick_at) { push @{$before{$iline[$k]}}, $k; }
+    for my $k (keys %init_call) { push @{$before{$iline[$k]}}, $k; }
+    my ($nt, @out) = (0);
+    for my $li (0 .. $#lines) {
+	if (!$before{$li}) { push @out, $lines[$li]; next; }
+	# the line's labels, then the tick, then its statement
+	my $s = $lines[$li];
+	my $labs = "";
+	while ($s =~ s/^(\s*(?:$sym|\d+):(?!:))//) { $labs .= $1; }
+	push @out, $labs if ($labs ne "");
+	my ($k) = @{$before{$li}};
+	if ($init_call{$k}) {
+	    push @out, "\tcall\t__rr_softticks_init";
+	} else {
+	    my ($l, $keep) = @{$tick_at{$k}};
+	    my ($pre, $post) = ("", "");
+	    my ($c, $o) = $l == $O ? (undef, $keep->[0]) : @$keep;
+	    $pre = "\tsetc\t$c\n" if ($l & $C);
+	    $pre .= "\tseto\t$o\n" if ($l & $O);
+	    if ($l == ($C | $O))	{ $post = "\n\tshlb\t\$7,$o\n\tshrb\t\$1,$c\n\tdecb\t$o"; }
+	    elsif ($l == $C)	{ $post = "\n\tshrb\t\$1,$c"; }
+	    elsif ($l == $O)	{ $post = "\n\taddb\t\$0x7f,$o"; }
+	    $nt++;
+	    push @out, $pre . tick_asm(".Lrr_softtick$nt") . $post;
+	}
+	push @out, $s;
+    }
+    push @out, $INIT_ASM if ($nt || %init_call);
+    if (defined($ENV{RR_SOFTTICKS_REPORT})) {
+	open(my $fh, ">>", $ENV{RR_SOFTTICKS_REPORT}) or die;
+	print $fh "$_\n" for (@report);
+	close($fh);
+    }
+    return join("\n", @out);
+}
+
+1;
