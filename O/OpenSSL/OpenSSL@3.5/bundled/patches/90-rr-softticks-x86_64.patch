diff --git a/crypto/bn/asm/x86_64-gcc.c b/crypto/bn/asm/x86_64-gcc.c
index 1e123ed..7bc9f56 100644
--- a/crypto/bn/asm/x86_64-gcc.c
+++ b/crypto/bn/asm/x86_64-gcc.c
@@ -68,6 +68,29 @@
 #undef mul
 #undef mul_add
 
+#if defined(__RR_SOFTTICKS__)
+#if __RR_SOFTTICKS__ != 1
+#error "unsupported rr software ticks ABI (rr's include/rr/softticks.h)"
+#endif
+/*
+ * rr software ticks: a compiler with a software-ticks pass ticks the C
+ * code, but not the loops in the asm statements below, so they tick at
+ * their head (RR_SOFTTICKS_X64_TICK_ASM, with a label that does not capture
+ * the loop's "1b"). Their carry crosses the back edge, and the tick
+ * clobbers the flags, so CF waits in the low byte of %0, which the loop
+ * writes before it reads it: setc keeps CF, shrb $1 restores it.
+ */
+#define BN_LOOP_HEAD "1:     setc    %b0             \n" \
+                     "       testb   $0x80,0x70001807\n" \
+                     "       jnz     7731f           \n" \
+                     "       decq    0x70001800      \n" \
+                     "       jnz     7731f           \n" \
+                     "       int3                    \n" \
+                     "7731:  shrb    $1,%b0          \n"
+#else
+#define BN_LOOP_HEAD "1:\n"
+#endif
+
 /*-
  * "m"(a), "+m"(r)      is the way to favor DirectPath µ-code;
  * "g"(0)               let the compiler to decide where does it
@@ -218,7 +241,8 @@ BN_ULONG bn_add_words(BN_ULONG *rp, const BN_ULONG *ap, const BN_ULONG *bp,
     asm volatile("       subq    %0,%0           \n" /* clear carry */
                  "       jmp     1f              \n"
                  ".p2align 4                     \n"
-                 "1:     movq    (%4,%2,8),%0    \n"
+                 BN_LOOP_HEAD
+                 "       movq    (%4,%2,8),%0    \n"
                  "       adcq    (%5,%2,8),%0    \n"
                  "       movq    %0,(%3,%2,8)    \n"
                  "       lea     1(%2),%2        \n"
@@ -245,7 +269,8 @@ BN_ULONG bn_sub_words(BN_ULONG *rp, const BN_ULONG *ap, const BN_ULONG *bp,
     asm volatile("       subq    %0,%0           \n" /* clear borrow */
                  "       jmp     1f              \n"
                  ".p2align 4                     \n"
-                 "1:     movq    (%4,%2,8),%0    \n"
+                 BN_LOOP_HEAD
+                 "       movq    (%4,%2,8),%0    \n"
                  "       sbbq    (%5,%2,8),%0    \n"
                  "       movq    %0,(%3,%2,8)    \n"
                  "       lea     1(%2),%2        \n"
diff --git a/crypto/perlasm/x86_64-softticks.pl b/crypto/perlasm/x86_64-softticks.pl
new file mode 100644
index 0000000..c58c496
--- /dev/null
+++ b/crypto/perlasm/x86_64-softticks.pl
@@ -0,0 +1,781 @@
+#! /usr/bin/env perl
+# Copyright 2026 The OpenSSL Project Authors. All Rights Reserved.
+#
+# Licensed under the Apache License 2.0 (the "License").  You may not use
+# this file except in compliance with the License.  You can obtain a copy
+# in the file LICENSE in the source distribution or at
+# https://www.openssl.org/source/license.html
+#
+# rr software ticks for x86_64-xlate.pl's ELF output (rr's
+# include/rr/softticks.h, ABI version 1).
+#
+# A compiler with a software-ticks pass predefines __RR_SOFTTICKS__ (the ABI
+# version), and the code it compiles counts its own progress: no instruction
+# executes twice in the same frame (at the same pc and %rsp) without a tick in
+# between. x86_64-xlate.pl calls softticks_insert() on its whole output when
+# $ENV{CC}, which the build passes to the perlasm scripts, is such a compiler;
+# otherwise nothing changes. A tick goes in
+#
+#   - every block that starts at a label which a jump at or after it (in the
+#     same section) targets: in a linear layout every cycle contains such a
+#     backward jump (the code has no indirect jumps; any is an error), and
+#   - the first block of every function (.type @function, .globl, or a call
+#     target), after its endbr64: a leaf called twice from one frame would
+#     run its first instructions at the same pc and %rsp.
+#
+# The tick is RR_SOFTTICKS_X64_TICK_ASM, byte for byte (rr recognizes it by
+# its bytes), and it sets all arithmetic flags. So it goes where in its block
+# no flag is live, if there is such a point. Where every point of the block
+# has a live flag, as in the multi-word carry chains of the bn Montgomery
+# code (adc/sbb, adcx/adox, whose carry crosses the loop's back edge with
+# inc/dec/lea/jrcxz counters), it goes where CF and OF at most are live and
+# a register is dead for each (the rest of the block writes it whole before
+# it reads it), which keeps the flag: setc/seto before the tick, and after it
+# shrb $1 (CF, and OF = 0) and decb of 0x80 or 0 (OF; CF is kept), or addb
+# $0x7f (OF alone). Anything else is an error.
+#
+# The liveness of the flags follows the code, in instructions and those that
+# x86_64-xlate.pl and the scripts encode with .byte/.long; a call's successor
+# is the callee's entry. A flag that an instruction leaves alone (bt and
+# ZF, cmpxchg8b/16b and all but ZF, a shift by a count that masks to 0)
+# counts as not written. pushf counts as reading every flag, except where
+# popf takes back what it pushed later in its block (the stack pointer
+# unchanged in between), and in the PadLock pattern: before a call of a
+# function that reads the pushed word only with "bt $30" (VIA's key-reload
+# flag, not an arithmetic flag) and leaves it alone otherwise. Errors: an
+# instruction this does not know (by name, or encoded in bytes that code
+# reaches), code that falls or jumps into data, an indirect jump, a jump
+# between sections, a flag read right after a call or a popf, an exported
+# function that reads a flag at its entry.
+#
+# Each object gets the initializer and the note (in their COMDAT group, as
+# the compiler emits them), and an .init section calls the initializer first:
+# x86_64cpuid.pl's calls OPENSSL_cpuid_setup, which ticks, and .init runs
+# before .init_array, where the initializer is.
+#
+# With RR_SOFTTICKS_REPORT set to a file, a line per tick is appended to it.
+
+package x86_64_softticks;
+
+use strict;
+use warnings;
+
+# Is $cc a software-ticks compiler? Its ABI version, or 0.
+sub softticks_enabled {
+    my ($cc) = @_;
+    return 0 if (!defined($cc) || $cc eq "");
+    my $v = `echo __RR_SOFTTICKS__ | $cc -E -P -x c - 2>/dev/null`;
+    $v =~ s/\s+//g;
+    return 0 if ($v eq "" || $v eq "__RR_SOFTTICKS__");
+    die "x86_64-softticks.pl: unsupported rr software ticks ABI \"$v\"\n" if ($v ne "1");
+    return 1;
+}
+
+# The arithmetic flags, as bits.
+my ($C, $P, $A, $Z, $S, $O) = (1, 2, 4, 8, 16, 32);
+my $ALL = 63;
+
+my %cc = (o=>$O, no=>$O, b=>$C, c=>$C, nae=>$C, ae=>$C, nb=>$C, nc=>$C,
+	  e=>$Z, z=>$Z, ne=>$Z, nz=>$Z, be=>$C|$Z, na=>$C|$Z, a=>$C|$Z, nbe=>$C|$Z,
+	  s=>$S, ns=>$S, p=>$P, pe=>$P, np=>$P, po=>$P, l=>$S|$O, nge=>$S|$O,
+	  ge=>$S|$O, nl=>$S|$O, le=>$Z|$S|$O, ng=>$Z|$S|$O, g=>$Z|$S|$O, nle=>$Z|$S|$O);
+# By opcode's low nibble (jcc, setcc, cmovcc).
+my @ccn = ($O, $O, $C, $C, $Z, $Z, $C|$Z, $C|$Z, $S, $S, $P, $P, $S|$O, $S|$O,
+	   $Z|$S|$O, $Z|$S|$O);
+
+# The flags a condition-code suffix (with an optional size suffix) reads:
+# every reading of an ambiguous spelling counts.
+sub cc_reads {
+    my ($s, $sizes) = @_;
+    my $r = 0;
+    $r |= $cc{$s} if (exists($cc{$s}));
+    $r |= $cc{$1} if ($sizes ne "" && $s =~ /^(.+)[$sizes]$/ && exists($cc{$1}));
+    return $r;
+}
+
+# The instructions that neither read nor write the arithmetic flags (those
+# of their families that do, such as ptest or kortest, come first below).
+my $neutral = qr/^(?:mov\w*|lea[wlq]?|xchg[bwlq]?|bswap[lq]?|not[bwlq]?|push[wq]?|pop[wq]?|
+		    c(?:bw|wde|dqe|wd|dq|qo|btw|wtl|ltq|wtd|ltd|qto)|(?:stos|lods)[bwlq]?|cld|std|
+		    nop[wlq]?|pause|int3|cpuid|rdtscp?|xgetbv|[lms]fence|prefetch\w*|clflush\w*|emms|
+		    mulx[lq]?|rorx[lq]?|sh[lr]x[lq]?|sarx[lq]?|pdep[lq]?|pext[lq]?|crc32[bwlq]?|
+		    aes\w+|sha1\w+|sha256\w+|sha512\w+|pclmul\w+|gf2p8\w+|v\w+|k\w+|p\w+|
+		    (?:add|sub|mul|div|min|max|sqrt|rsqrt|rcp|and|andn|or|xor|cmp|shuf|unpck[hl]|
+		       blendv?|round|dp|hadd|hsub|addsub)(?:p[sd]|s[sd])|cvt\w+|insertps|extractps|
+		    [ls]dmxcsr|fx(?:save|rstor)\w*|xsave\w*|xrstor\w*)$/x;
+
+# Control: "n" (falls through), "ret", "stop", "jmp", "jcc", "call",
+# "prefix" (a prefix only, of the next instruction), "endbr".
+# Returns (control, flags read, flags written).
+sub insn_flags {
+    my ($m, $o) = @_;
+    return ("ret", 0, 0)		if ($m =~ /^ret[lq]?$/);
+    return ("stop", 0, 0)		if ($m =~ /^(?:ud2|hlt)$/);
+    return ("endbr", 0, 0)		if ($m eq "endbr64");
+    return ("jmp", 0, 0)		if ($m =~ /^jmp[q]?$/);
+    return ("call", 0, $ALL)		if ($m =~ /^call[q]?$/);
+    return ("jcc", 0, 0)		if ($m =~ /^j[er]?cxz$/ || $m =~ /^loop[lq]?$/);
+    return ("jcc", $Z, 0)		if ($m =~ /^loopn?[ez][lq]?$/);
+    if ($m =~ /^j(.+)$/) {
+	my $r = cc_reads($1, "");
+	die "x86_64-softticks.pl: unknown jump $m\n" if (!$r);
+	return ("jcc", $r, 0);
+    }
+    if ($m =~ /^set(.+)$/ && (my $r = cc_reads($1, "b")))	{ return ("n", $r, 0); }
+    if ($m =~ /^cmov(.+)$/ && (my $r = cc_reads($1, "wlq")))	{ return ("n", $r, 0); }
+    return ("n", $ALL, 0)		if ($m =~ /^fcmov/);
+    return ("n", $C, $ALL)		if ($m =~ /^(?:adc|sbb)[bwlq]?$/);
+    return ("n", $C, $C)		if ($m =~ /^adcx[lq]?$/);
+    return ("n", $O, $O)		if ($m =~ /^adox[lq]?$/);
+    return ("n", $C, 0)			if ($m =~ /^(?:rcl|rcr)[bwlq]?$/);
+    return ("n", $ALL & ~$O, 0)		if ($m eq "lahf");
+    return ("n", $ALL, 0)		if ($m =~ /^pushf[wlq]?$/);	# but see softticks_insert
+    return ("n", $C, $C)		if ($m eq "cmc");
+    return ("n", 0, $C)			if ($m =~ /^(?:clc|stc)$/);
+    return ("n", 0, $ALL & ~$O)		if ($m eq "sahf");
+    return ("n", 0, $ALL)		if ($m =~ /^popf[wlq]?$/);
+    return ("n", 0, $ALL & ~$C)		if ($m =~ /^(?:inc|dec)[bwlq]?$/);
+    if ($m =~ /^(?:shl|shr|sal|sar|shld|shrd|rol|ror)[bwlq]?$/) {
+	return ("n", 0, 0)		if ($o =~ /%cl\b/);	# the count may be 0
+	if ($o =~ /^\$(0x[0-9a-f]+|\d+)\s*,/i) {	# a count that masks to 0 writes none
+	    my $n = $1;
+	    $n = $n =~ /^0x/i ? hex($n) : $n + 0;
+	    return ("n", 0, 0)		if (($n & ($m =~ /q$/ || $o =~ /%r(?:[a-ds]i|[a-ds]x|[bs]p|\d+)\s*$/ ? 63 : 31)) == 0);
+	}
+	return ("n", 0, $C|$O)		if ($m =~ /^ro/);
+	return ("n", 0, $ALL);
+    }
+    return ("n", 0, $ALL & ~$Z)		if ($m =~ /^bt[src]?[wlq]?$/);	# ZF stays
+    return ("n", 0, $Z)			if ($m =~ /^cmpxchg(?:8|16)b$/);
+    return ("n", 0, $ALL)		if ($m =~ /^(?:add|sub|and|or|xor|cmp|test|neg|mul|imul|div|idiv|bsf|bsr|popcnt|lzcnt|tzcnt|andn|bextr|blsi|blsmsk|blsr|bzhi|xadd|cmpxchg|rdrand|rdseed)[bwlq]?$/);
+    return ("n", 0, $ALL)		if ($m =~ /^(?:v?u?comis[sd]|v?ptest|vtestp[sd]|kortest[bwdq]|ktest[bwdq])$/);
+    return ("n", 0, $ALL)		if ($m =~ /^(?:cmps|scas)[bwlq]?$/);	# without rep
+    return ("n", 0, 0)			if ($m =~ $neutral);
+    return ();				# not known
+}
+
+my %legacy_prefix = map { $_ => 1 } (0x26, 0x2e, 0x36, 0x3e, 0x64, 0x65, 0x66, 0x67, 0xf0, 0xf2, 0xf3);
+
+# The length of a ModRM byte at $b->[$i] with its SIB and displacement.
+sub modrm_len {
+    my ($b, $i) = @_;
+    return undef if ($i >= @$b);
+    my ($mod, $rm) = ($b->[$i] >> 6, $b->[$i] & 7);
+    return 1 if ($mod == 3);
+    my $l = 1;
+    if ($rm == 4) {
+	return undef if ($i + 1 >= @$b);
+	$l++;
+	$l += 4 if ($mod == 0 && ($b->[$i + 1] & 7) == 5);
+    } elsif ($mod == 0 && $rm == 5) {
+	$l += 4;			# %rip relative
+    }
+    $l += $mod == 1 ? 1 : $mod == 2 ? 4 : 0;
+    return $l;
+}
+
+# The instruction at $b->[$i]: (length, control, flags read, flags written),
+# or () if this does not know it. Only the flags' readers must all be known;
+# where the writers are not, the flags count as not written.
+sub decode_one {
+    my ($b, $i0) = @_;
+    my ($i, %p, $w) = ($i0);
+    while ($i < @$b && $legacy_prefix{$b->[$i]}) { $p{$b->[$i++]} = 1; }
+    if ($i < @$b && $b->[$i] >= 0x40 && $b->[$i] <= 0x4f) { $w = $b->[$i] & 8; $i++; }
+    return ($i - $i0, "prefix", 0, 0)	if ($i == @$b);
+    my $op = $b->[$i++];
+    my $r = $i < @$b ? ($b->[$i] >> 3) & 7 : -1;	# ModRM's reg field
+    my $mr = sub { my $l = modrm_len($b, $i); return defined($l) ? ($i + $l + ($_[0] // 0) - $i0) : undef; };
+    my $ret = sub { my ($l, @f) = @_; return defined($l) && $i0 + $l <= @$b ? ($l, @f) : (); };
+    my $imm = $p{0x66} ? 2 : 4;
+    # one-byte opcodes
+    if ($op < 0x40 && ($op & 7) < 6) {	# add, or, adc, sbb, and, sub, xor, cmp
+	my $rd = ($op >> 3) == 2 || ($op >> 3) == 3 ? $C : 0;
+	my $l = ($op & 7) < 4 ? $mr->() : ($i - $i0) + (($op & 7) == 4 ? 1 : $imm);
+	return $ret->($l, "n", $rd, $ALL);
+    }
+    return $ret->($i - $i0, "n", 0, 0)	if ($op >= 0x50 && $op <= 0x5f);	# push, pop
+    return $ret->($mr->(), "n", 0, 0)	if ($op == 0x63);			# movslq
+    return $ret->($mr->($op == 0x69 ? $imm : 1), "n", 0, $ALL) if ($op == 0x69 || $op == 0x6b);	# imul
+    if ($op >= 0x80 && $op <= 0x83 && $op != 0x82) {
+	return $ret->($mr->($op == 0x81 ? $imm : 1), "n", $r == 2 || $r == 3 ? $C : 0, $ALL);
+    }
+    return $ret->($mr->(), "n", 0, $ALL)	if ($op == 0x84 || $op == 0x85);	# test
+    return $ret->($mr->(), "n", 0, 0)	if ($op >= 0x86 && $op <= 0x8b || $op == 0x8d);	# xchg, mov, lea
+    return $ret->($i - $i0, "n", 0, 0)	if ($op >= 0x90 && $op <= 0x99);	# nop, xchg, cltq, cqto
+    return $ret->($i - $i0, "n", $ALL, 0)	if ($op == 0x9c);	# pushf
+    return $ret->($i - $i0, "n", 0, $ALL)	if ($op == 0x9d);	# popf
+    return $ret->($i - $i0, "n", 0, $ALL & ~$O) if ($op == 0x9e);	# sahf
+    return $ret->($i - $i0, "n", $ALL & ~$O, 0) if ($op == 0x9f);	# lahf
+    if ($op >= 0xa4 && $op <= 0xaf) {	# string instructions
+	return $ret->($i - $i0, "n", 0, ($op == 0xa6 || $op == 0xa7 || $op >= 0xae) && !$p{0xf3} && !$p{0xf2} ? $ALL : 0)
+	    if ($op != 0xa8 && $op != 0xa9);
+	return $ret->($i - $i0 + ($op == 0xa8 ? 1 : $imm), "n", 0, $ALL);	# test imm
+    }
+    return $ret->($i - $i0 + 1, "n", 0, 0)	if ($op >= 0xb0 && $op <= 0xb7);
+    return $ret->($i - $i0 + ($w ? 8 : $imm), "n", 0, 0) if ($op >= 0xb8 && $op <= 0xbf);
+    if ($op == 0xc0 || $op == 0xc1 || $op >= 0xd0 && $op <= 0xd3) {	# shifts, rotates
+	my $l = $mr->($op <= 0xc1 ? 1 : 0);
+	return $ret->($l, "n", $C, 0)	if ($r == 2 || $r == 3);	# rcl, rcr
+	return $ret->($l, "n", 0, 0)	if ($op == 0xd2 || $op == 0xd3);	# by %cl
+	return $ret->($l, "n", 0, 0)	if ($op <= 0xc1 && defined($l) && $i0 + $l <= @$b &&
+					    ($b->[$i0 + $l - 1] & ($w && $op == 0xc1 ? 63 : 31)) == 0);	# by 0
+	return $ret->($l, "n", 0, $r < 2 ? $C | $O : $ALL);
+    }
+    return $ret->($i - $i0, "ret", 0, 0)	if ($op == 0xc3);
+    return $ret->($mr->($op == 0xc6 ? 1 : $imm), "n", 0, 0) if (($op == 0xc6 || $op == 0xc7) && $r == 0);
+    return $ret->($i - $i0, "n", 0, 0)	if ($op == 0xcc);		# int3
+    return $ret->($i - $i0, "n", $C, $C)	if ($op == 0xf5);	# cmc
+    if ($op == 0xf6 || $op == 0xf7) {
+	return $ret->($mr->($op == 0xf6 ? 1 : $imm), "n", 0, $ALL) if ($r <= 1);	# test
+	return $ret->($mr->(), "n", 0, $r == 2 ? 0 : $ALL);	# not, neg, mul, imul, div, idiv
+    }
+    return $ret->($i - $i0, "n", 0, $C)	if ($op == 0xf8 || $op == 0xf9);	# clc, stc
+    return $ret->($i - $i0, "n", 0, 0)	if ($op >= 0xfa && $op <= 0xfd);	# cli, sti, cld, std
+    if ($op == 0xfe || $op == 0xff) {
+	return $ret->($mr->(), "n", 0, $ALL & ~$C) if ($r <= 1);	# inc, dec
+	return $ret->($mr->(), "n", 0, 0)	if ($op == 0xff && $r == 6);	# push
+	return ();				# indirect call or jump
+    }
+    if ($op == 0xc4 || $op == 0xc5 || $op == 0x62 || $op == 0x8f && $i < @$b && ($b->[$i] & 0x1f) >= 8) {
+	# VEX, EVEX, XOP: none reads the flags
+	my $n = $op == 0xc5 ? 1 : $op == 0x62 ? 3 : 2;
+	return () if ($i + $n >= @$b);
+	my $map = $op == 0xc5 ? 1 : $op == 0x62 ? $b->[$i] & 7 : $b->[$i] & 0x1f;
+	$i += $n;
+	my $o = $b->[$i++];
+	my $im = $map == 3 || $map == 8 || $map == 1 && ($o >= 0x70 && $o <= 0x73 || $o == 0xc2 || $o >= 0xc4 && $o <= 0xc6) ? 1 : $map == 10 ? 4 : 0;
+	return $ret->($mr->($im), "n", 0, 0);
+    }
+    return $ret->($mr->(), "n", 0, 0)	if ($op == 0x8f && $r == 0);	# pop
+    return ()				if ($op != 0x0f || $i >= @$b);
+    my $o2 = $b->[$i++];
+    $r = $i < @$b ? ($b->[$i] >> 3) & 7 : -1;
+    if ($o2 == 0x38) {
+	return () if ($i >= @$b);
+	my $o3 = $b->[$i++];
+	if ($o3 == 0xf6) {
+	    return $ret->($mr->(), "n", $O, $O) if ($p{0xf3});		# adox
+	    return $ret->($mr->(), "n", $C, $C) if ($p{0x66});		# adcx
+	    return ();
+	}
+	return $ret->($mr->(), "n", 0, $o3 == 0x17 ? $ALL : 0);	# ptest; SSSE3, SSE4, AES-NI, SHA, movbe
+    }
+    if ($o2 == 0x3a) {
+	return () if ($i >= @$b);
+	my $o3 = $b->[$i++];
+	return $ret->($mr->(1), "n", 0, $o3 >= 0x60 && $o3 <= 0x63 ? $ALL : 0);	# pcmp?str?; palignr, pclmulqdq, ...
+    }
+    return $ret->($i - $i0 + 1, "endbr", 0, 0) if ($o2 == 0x1e && $p{0xf3} && $i < @$b && $b->[$i] == 0xfa);
+    return $ret->($i - $i0, "stop", 0, 0)	if ($o2 == 0x0b);	# ud2
+    return $ret->($i - $i0, "n", 0, 0)	if ($o2 == 0xa2 || $o2 == 0x31);	# cpuid, rdtsc
+    return $ret->($i - $i0 + 1, "n", 0, 0)	if ($o2 == 0x01 && $i < @$b && $b->[$i] == 0xd0);	# xgetbv
+    return $ret->($i - $i0 + 1, "n", 0, 0)	if ($o2 == 0xa6 || $o2 == 0xa7);	# PadLock
+    return $ret->($mr->(), "n", 0, $ALL)	if ($o2 == 0xc7 && ($r == 6 || $r == 7));	# rdrand, rdseed
