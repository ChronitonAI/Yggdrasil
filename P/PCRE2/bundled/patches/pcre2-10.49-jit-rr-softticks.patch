   sljit_emit_op_src(compiler, (op), (src), (srcw))
+#ifdef __RR_SOFTTICKS__
 #define LABEL() \
+  emit_softtick_label(compiler)
+#define SOFTTICK() \
+  emit_softtick(compiler)
+#else
+#define LABEL() \
+  sljit_emit_label(compiler)
+#define SOFTTICK() do {} while(0)
+#endif
+/* A label that only jumps emitted before it can reach. */
+#define FORWARD_LABEL() \
   sljit_emit_label(compiler)
 #define JUMP(type) \
   sljit_emit_jump(compiler, (type))
@@ -680,6 +691,95 @@ the start pointers when the end of the capturing group has not yet reached. */
 #define GET_LOCAL_BASE(dst, dstw, offset) \
   sljit_get_local_base(compiler, (dst), (dstw), (offset))
 
+#ifdef __RR_SOFTTICKS__
+
+/* Software ticks for the rr debugger. A program built with a compiler pass
+that counts software ticks (the pass predefines __RR_SOFTTICKS__ to the
+version of rr's software-ticks ABI, include/rr/softticks.h in rr) counts its
+own progress instead of relying on the CPU's branch counter: the pass places a
+short code sequence, a tick, so that no instruction runs twice in the same
+stack frame without a tick in between. rr can preempt such a program, and place
+asynchronous signals in it on replay, only where it ticks, so the machine code
+generated here must tick in the same way.
+
+The generated code ticks at the start of the main function, and at every label
+made by LABEL(): those are the only labels that can be jumped to backwards
+(loop heads, the targets of backtracking jumps), called (fast-call subroutines)
+or jumped to indirectly (after their SLJIT_ENDBR). A label made by JUMPHERE()
+or FORWARD_LABEL() is only the target of jumps emitted before it, i.e. forward
+jumps, and needs none (the entry label of a fast-call subroutine is a LABEL()).
+The tick clobbers the status flags on x86, which are never live across a label
+or at the function start, and x16 and x17 on ARM64, which the generated code
+never allocates (it uses 5 scratch and 5 saved registers, and sljit's own
+temporaries are x9, x10 and x30). The sequence is part of the ABI: rr
+recognizes a tick trap by its bytes. */
+
+#if __RR_SOFTTICKS__ != 1
+#error "Unsupported version of the rr software-ticks ABI"
+#endif
+
+static void emit_softtick(struct sljit_compiler *compiler)
+{
+#if defined SLJIT_CONFIG_X86_64 && SLJIT_CONFIG_X86_64
+static const sljit_u8 tick[] = {
+  0xf6, 0x04, 0x25, 0x07, 0x18, 0x00, 0x70, 0x80, /* testb $0x80, 0x70001807 */
+  0x75, 0x0b,                                     /* jnz 1f */
+  0x48, 0xff, 0x0c, 0x25, 0x00, 0x18, 0x00, 0x70, /* decq 0x70001800 */
+  0x75, 0x01,                                     /* jnz 1f */
+  0xcc                                            /* int3; 1: */
+};
+static const sljit_u8 lengths[] = { 8, 2, 8, 2, 1 };
+#elif defined SLJIT_CONFIG_X86_32 && SLJIT_CONFIG_X86_32
+static const sljit_u8 tick[] = {
+  0xf6, 0x05, 0x07, 0x18, 0x00, 0x70, 0x80, /* testb $0x80, 0x70001807 */
+  0x75, 0x13,                               /* jnz 1f */
+  0x83, 0x2d, 0x00, 0x18, 0x00, 0x70, 0x01, /* subl $1, 0x70001800 */
+  0x75, 0x0a,                               /* jnz 1f */
+  0x83, 0x2d, 0x04, 0x18, 0x00, 0x70, 0x01, /* subl $1, 0x70001804 */
+  0x73, 0x01,                               /* jae 1f */
+  0xcc                                      /* int3; 1: */
+};
+static const sljit_u8 lengths[] = { 7, 2, 7, 2, 7, 2, 1 };
+#elif defined SLJIT_CONFIG_ARM_64 && SLJIT_CONFIG_ARM_64
+static const sljit_u32 tick[] = {
+  0xd2ae0030, /* movz x16, #0x7001, lsl #16 */
+  0xf9440211, /* ldr x17, [x16, #0x800] */
+  0xb7f800b1, /* tbnz x17, #63, 1f */
+  0xd1000631, /* sub x17, x17, #1 */
+  0xf9040211, /* str x17, [x16, #0x800] */
+  0xb5000051, /* cbnz x17, 1f */
+  0xd42a6a80, /* brk #0x5354 */
+  0xaa1f03f1  /* 1: mov x17, xzr */
+};
+#else
+#error "The JIT compiler does not support rr software ticks on this architecture"
+#endif
+sljit_u32 i;
+
+#if defined SLJIT_CONFIG_X86 && SLJIT_CONFIG_X86
+const sljit_u8 *inst = tick;
+
+for (i = 0; i < sizeof(lengths); i++)
+  {
+  sljit_emit_op_custom(compiler, (void *)inst, lengths[i]);
+  inst += lengths[i];
+  }
+#else
+for (i = 0; i < sizeof(tick) / sizeof(tick[0]); i++)
+  sljit_emit_op_custom(compiler, (void *)(tick + i), sizeof(tick[0]));
+#endif
+}
+
+static struct sljit_label *emit_softtick_label(struct sljit_compiler *compiler)
+{
+struct sljit_label *label = sljit_emit_label(compiler);
+
+emit_softtick(compiler);
+return label;
+}
+
+#endif /* __RR_SOFTTICKS__ */
