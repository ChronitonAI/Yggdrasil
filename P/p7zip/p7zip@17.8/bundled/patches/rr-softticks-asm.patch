@@ -187,6 +187,7 @@ MY_PROC @CatStr(CrcUpdateT, %(NUM_WORDS * 4)), 4
         cmp     rN, NUM_BYTES_LIMIT + ALIGN_MASK
         jb      crc_end
 @@:
