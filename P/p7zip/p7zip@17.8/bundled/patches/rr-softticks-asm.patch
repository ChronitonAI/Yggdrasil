rr software ticks (rr's include/rr/softticks.h, ABI version 1) for 7-Zip's hand-written x86-64
assembly (Asm/x86, MASM syntax, assembled by uasm with USE_ASM): 7zAsm.asm defines MY_SOFTTICK,
the ABI's x86-64 tick sequence byte for byte, and MY_PROC ticks every function at its entry;
every loop of 7zCrcOpt, XzCrc64Opt, Sha1Opt, Sha256Opt, AesOpt, LzFindOpt, LzmaDecOpt and Sort
ticks where every cycle through it passes and no flag is live (a loop around another one that
always runs needs no tick; the byte loops of the LZMA decoder's match copy and of the match
finder's compare are unrolled 4 times under the macro). All of it is conditional on
__RR_SOFTTICKS__, which the recipe passes to uasm when the C compiler predefines it (the
software-ticks plugin does): without it the objects are byte-identical. On anything but x86-64
the macro makes the x86 files and Asm/arm64/LzmaDecOpt.S fail to assemble (they have no ticks
for those targets yet) rather than build unticked code. Applies to the sources with their CRLF
line ends converted to LF (the recipe does that first; uasm reads either).

diff --git a/Asm/arm64/LzmaDecOpt.S b/Asm/arm64/LzmaDecOpt.S
index 10dc473..91f4dda 100755
--- a/Asm/arm64/LzmaDecOpt.S
+++ b/Asm/arm64/LzmaDecOpt.S
@@ -13,6 +13,14 @@
 
 #include "7zAsm.S"
 
+#if defined(__RR_SOFTTICKS__)
+/* rr software ticks (rr's include/rr/softticks.h): a compiler with a software-ticks pass
+   predefines __RR_SOFTTICKS__ and ticks the code it compiles; this file has no ticks yet.
+   Its loops would need the arm64 tick, which clobbers x16 and x17, where this decoder keeps
+   bufLimit and dicBufSize (r16, r17). Until then, build without USE_ASM (the C decoder). */
+#error "LzmaDecOpt.S has no rr software ticks: build 7-Zip without USE_ASM"
+#endif
+
 	// .arch armv8-a
 	// .file        "LzmaDecOpt.c"
 	.text
diff --git a/Asm/x86/7zAsm.asm b/Asm/x86/7zAsm.asm
index 8910d16..8b2a4aa 100755
--- a/Asm/x86/7zAsm.asm
+++ b/Asm/x86/7zAsm.asm
@@ -46,6 +46,40 @@ endif
 OPTION PROLOGUE:NONE
 OPTION EPILOGUE:NONE
 
+; rr software ticks (rr's include/rr/softticks.h, ABI version 1). Code built
+; for rr's software-ticks mode counts its own progress: no instruction may run
+; twice in the same frame without a tick in between. The compiler plugin ticks
+; C code; this assembly ticks by hand: MY_SOFTTICK at every function entry (in
+; MY_PROC) and in every loop, at a place that every cycle through it passes (a
+; loop around another one that always runs needs no tick of its own; the
+; tightest byte loops are unrolled under __RR_SOFTTICKS__, one tick per 4
+; bytes). The build passes -D__RR_SOFTTICKS__=<ABI version> to the assembler
+; when the C compiler predefines __RR_SOFTTICKS__ (the softticks plugins do);
+; otherwise MY_SOFTTICK is empty and the code is unchanged.
+; The tick clobbers the flags (only): it goes where no flag is live.
+; Its label is LOCAL, so it never captures an @B / @F of the code around it.
+ifdef __RR_SOFTTICKS__
+  if __RR_SOFTTICKS__ ne 1
+    .err <unsupported rr software ticks ABI version>
+  endif
+  ifndef x64
+    .err <rr software ticks: only the x86-64 tick is implemented>
+  endif
+MY_SOFTTICK macro
+    LOCAL done
+        ; the byte-exact x86-64 RR_SOFTTICKS_TICK_ASM
+        test    byte ptr [70001807h], 80h
+        jnz     done
+        dec     qword ptr [70001800h]
+        jnz     done
+        int     3
+done:
+endm
+else
+MY_SOFTTICK macro
+endm
+endif
+
 MY_ASM_START macro
   ifdef x64
     .code
@@ -69,6 +103,7 @@ MY_PROC macro name:req, numParams:req
     proc_name equ @CatStr(@,name,@, %numParams * 4)
   endif
   proc_name PROC
+  MY_SOFTTICK
 endm
 
 MY_ENDP macro
