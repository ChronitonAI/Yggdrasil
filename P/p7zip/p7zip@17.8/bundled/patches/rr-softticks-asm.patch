         test    rD_x, ALIGN_MASK    ; test    rD, ALIGN_MASK
         jz      @F
         CRC1b
@@ -198,6 +199,7 @@ MY_PROC @CatStr(CrcUpdateT, %(NUM_WORDS * 4)), 4
 
 align 16
 @@:
+        MY_SOFTTICK
 unr_index = 0
 while unr_index lt UNROLL_CNT
     if (unr_index and 1) eq 0
@@ -221,6 +223,7 @@ else
         add     rN, 4 * NUM_WORDS * UNROLL_CNT
         sub     rD, 4 * NUM_WORDS * UNROLL_CNT
 @@:
+        MY_SOFTTICK
         MOVZXLO x3, x0
         MOVZXHI x1, x0
         shr     x0, 16
@@ -248,6 +251,7 @@ crc_end:
         test    rN, rN
         jz      func_end
 @@:
+        MY_SOFTTICK
         CRC1b
         jnz     @B
 
