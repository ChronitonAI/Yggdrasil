rr software ticks (rr's tracee ABI version 1) for GMP's x86-64 assembly and inline asm.

A compiler built for rr's software ticks predefines __RR_SOFTTICKS__ (the ABI version) and
ticks the code it compiles, but not hand-written assembly or the loops inside inline asm.

- configure.ac: with such a compiler, define RR_SOFTTICKS in config.m4 for x86-64 Linux
  (ABI=64); refuse other assembly (it does not tick: configure with --disable-assembly).
- mpn/x86_64/x86_64-defs.m4: the tick macros (RR_SOFTTICK, RR_SOFTTICK_CF, RR_SOFTTICK_CO,
  and RR_SOFTTICK_JRCXZ/RR_SOFTTICK_FAR for a jrcxz that ticks put out of reach), and a
  tick at every PROLOGUE.  rr-softticks-2-loops.patch puts the loop ticks in.
- bt1/aors_n.asm, coreibwl/mullo_basecase.asm, coreibwl/sqr_basecase.asm,
  zen/sqr_basecase.asm: the jrcxz instructions whose targets the ticks put out of reach.
- gmp-impl.h: a tick in MPN_IORD_U's carry propagation loop (MPN_INCR_U, MPN_DECR_U).

All of it expands to nothing without RR_SOFTTICKS / __RR_SOFTTICKS__: the object code is
the same as without this patch.

diff -ruN a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -2667,6 +2667,33 @@
 esac
 
 
+# rr software ticks.  A compiler built for rr's software ticks predefines
+# __RR_SOFTTICKS__ (the tracee ABI version) and ticks the code it compiles,
+# but not hand-written assembly.  The x86-64 assembly ticks by hand when
+# RR_SOFTTICKS is defined in config.m4 (see mpn/x86_64/x86_64-defs.m4);
+# other assembly does not tick, so it must not be used with such a compiler.
+AC_MSG_CHECKING([whether the compiler is built for rr software ticks])
+AC_COMPILE_IFELSE([AC_LANG_SOURCE([[
+#ifndef __RR_SOFTTICKS__
+#error not built for rr software ticks
+#endif
+int gmp_rr_softticks;]])], [gmp_rr_softticks=yes], [gmp_rr_softticks=no])
+AC_MSG_RESULT($gmp_rr_softticks)
+if test $gmp_rr_softticks = yes && test "$enable_assembly" = "yes"; then
+  gmp_rr_softticks_asm=no
+  case $host in
+    X86_64_PATTERN)
+      case $ABI/$host in
+        64/*-*-linux*) gmp_rr_softticks_asm=yes ;;
+      esac ;;
+  esac
+  if test $gmp_rr_softticks_asm = yes; then
+    GMP_DEFINE_RAW(["define(<RR_SOFTTICKS>,1)"])
+  else
+    AC_MSG_ERROR([the assembly for $host (ABI=$ABI) has no rr software ticks, configure with --disable-assembly])
+  fi
+fi
+
 if test "$enable_assembly" = "no"; then
   path="generic"
   AC_DEFINE([NO_ASM],1,[Define to 1 to disable the use of inline assembly])
diff -ruN a/gmp-impl.h b/gmp-impl.h
--- a/gmp-impl.h
+++ b/gmp-impl.h
@@ -2781,6 +2781,34 @@
 /* Better flags handling than the generic C gives on i386, saving a few
    bytes of code and maybe a cycle or two.  */
 
+/* rr software ticks (rr's include/rr/softticks.h, tracee ABI version 1): a
+   compiler built for them predefines __RR_SOFTTICKS__ and ticks the code it
+   compiles, but not loops inside inline assembly.  MPN_IORD_U_TICK is the
+   ABI's tick sequence, exactly (rr recognizes its bytes); it clobbers the
+   flags only, and goes at the top of the carry propagation loop below, where
+   no flag is live (the add or sub there sets them all).  */
+#if defined (__RR_SOFTTICKS__) && defined (__x86_64__)
+#define MPN_IORD_U_TICK							\
+  "\ttestb\t$0x80, 0x70001807\n"					\
+  "\tjnz\t1f\n"								\
+  "\tdecq\t0x70001800\n"						\
+  "\tjnz\t1f\n"								\
+  "\tint3\n"								\
+  "1:\n"
+#elif defined (__RR_SOFTTICKS__) && defined (__i386__)
+#define MPN_IORD_U_TICK							\
+  "\ttestb\t$0x80, 0x70001807\n"					\
+  "\tjnz\t1f\n"								\
+  "\tsubl\t$1, 0x70001800\n"						\
+  "\tjnz\t1f\n"								\
+  "\tsubl\t$1, 0x70001804\n"						\
+  "\tjae\t1f\n"								\
+  "\tint3\n"								\
+  "1:\n"
+#else
+#define MPN_IORD_U_TICK ""
+#endif
+
 #define MPN_IORD_U(ptr, incr, aors)					\
   do {									\
     mp_ptr  __ptr_dummy;						\
@@ -2791,6 +2819,7 @@
       {									\
 	__asm__ __volatile__						\
 	  ("\n" ASM_L(top) ":\n"					\
+	   MPN_IORD_U_TICK						\
 	   "\t" aors "\t$1, (%0)\n"					\
 	   "\tlea\t%c2(%0), %0\n"					\
 	   "\tjc\t" ASM_L(top)						\
@@ -2804,6 +2833,7 @@
 	  (   aors  "\t%2, (%0)\n"					\
 	   "\tjnc\t" ASM_L(done) "\n"					\
 	   ASM_L(top) ":\n"						\
+	   MPN_IORD_U_TICK						\
 	   "\t" aors "\t$1, %c3(%0)\n"					\
 	   "\tlea\t%c3(%0), %0\n"					\
 	   "\tjc\t" ASM_L(top) "\n"					\
