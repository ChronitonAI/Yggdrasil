+dnl  rr software ticks (rr's include/rr/softticks.h, tracee ABI version 1).
+dnl
+dnl  A compiler built for rr's software ticks predefines __RR_SOFTTICKS__ (the
+dnl  ABI version) and ticks the code it compiles: at every function entry and
+dnl  on every loop, so that no instruction runs twice in one stack frame (at
+dnl  the same pc and stack pointer) without a tick in between.  configure then
+dnl  defines RR_SOFTTICKS here, and the assembly ticks by hand: PROLOGUE at
+dnl  every entry point, and every loop on each iteration with one of the
+dnl  macros below (at the positions that softticks/gmpticks.py in the recipe
+dnl  chose: right after the loop's label where no flag is live, else the
+dnl  first place on the iteration's path where none is, else saving what is
+dnl  live in registers that are dead there).  Without RR_SOFTTICKS they all
+dnl  expand to nothing.
+dnl
+dnl  RR_SOFTTICK_SEQ is the ABI's x86-64 tick, exactly: rr recognizes a tick
+dnl  by its bytes.  It tests the top bit of the countdown at 0x70001800
+dnl  (disarmed while set, as it is outside rr), decrements the countdown and
+dnl  traps (int3) when that reaches 0.  It clobbers the arithmetic flags and
+dnl  nothing else; the numeric label 7731 is local to it.
+dnl
+dnl  RR_SOFTTICK            no arithmetic flag is live
+dnl  RR_SOFTTICK_CF(r)      only CF is live; r (a 64-bit register name) is
+dnl                         dead: its low byte keeps CF across the tick
+dnl  RR_SOFTTICK_CO(r1,r2)  only CF and OF are live (adcx/adox chains); r1
+dnl                         and r2 are dead and keep CF and OF
+
+define(`RR_SOFTTICK_SEQ',
+`	testb	$`'0x80, 0x70001807
+	jnz	7731f
+	decq	0x70001800
+	jnz	7731f
+	int3
+7731:')
+
+define(`RR_SOFTTICK',
+`ifdef(`RR_SOFTTICKS',`RR_SOFTTICK_SEQ')')
+
+dnl  CF in r's low byte: setc, and after the tick 0xff + (0 or 1) carries iff
+dnl  CF was set.
+
+define(`RR_SOFTTICK_CF',
+m4_assert_numargs(1)
+`ifdef(`RR_SOFTTICKS',
+`	setc	R8($1)
+RR_SOFTTICK_SEQ
+	addb	$-1, R8($1)')')
+
+dnl  CF in r1's low byte as above; OF in r2's low byte as 0x7e + OF, which inc
+dnl  overflows iff it is 0x7f.  inc keeps the CF that the add restored.
+
+define(`RR_SOFTTICK_CO',
+m4_assert_numargs(2)
+`ifdef(`RR_SOFTTICKS',
+`	setc	R8($1)
+	seto	R8($2)
+RR_SOFTTICK_SEQ
+	subb	$-126, R8($2)
+	addb	$-1, R8($1)
+	incb	R8($2)')')
+
+dnl  RR_SOFTTICK_JRCXZ(lbl) is `jrcxz L(lbl)', for a jrcxz whose 8-bit
+dnl  displacement the ticks between it and L(lbl) would overflow: with
+dnl  RR_SOFTTICKS it jumps to L(lbl_rr), a `jmp L(lbl)' that
+dnl  RR_SOFTTICK_FAR(lbl) places within reach, after an unconditional jump.
+
+define(`RR_SOFTTICK_JRCXZ',
+m4_assert_numargs(1)
+`ifdef(`RR_SOFTTICKS',`jrcxz	L($1_rr)',`jrcxz	L($1)')')
+
+define(`RR_SOFTTICK_FAR',
+m4_assert_numargs(1)
+`ifdef(`RR_SOFTTICKS',`L($1_rr):	jmp	L($1)')')
+
+
 divert`'dnl
