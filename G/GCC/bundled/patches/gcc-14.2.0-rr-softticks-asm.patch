--- a/libitm/config/x86/rr-softticks.h
+++ b/libitm/config/x86/rr-softticks.h
@@ -0,0 +1,42 @@
+/* rr software ticks (rr's include/rr/softticks.h, ABI version 1) for libitm's x86-64
+   assembly, sjlj.S.
+
+   Code built for rr's software-ticks mode counts its own progress: no instruction may run
+   twice at the same (pc, sp) without a tick in between.  The compiler plugin ticks compiled
+   code and predefines __RR_SOFTTICKS__ (the ABI version) for .S files too; sjlj.S is ticked
+   by hand, at each function's entry (a function called twice from one frame runs its first
+   instructions at the same (pc, sp) twice) and once per iteration of each loop:
+   - _ITM_beginTransaction: at its entry, and just before `jmp .Lhtm_fastpath', the HTM
+     retry's back edge.  Both are outside the region from xbegin to the ret or xabort: a tick
+     in there would be rolled back with the hardware transaction when it aborts.
+   - GTM_longjmp: at its entry, and at .L4, the head of the loop that pops the shadow stack
+     255 frames at a time (with CET, -mshstk).
+   A tick clobbers the arithmetic flags and nothing else: no register, no stack.  The flags
+   are dead at all of these places: function entries; before the retry's jmp (xbegin reads
+   no flags, the cmpl after it writes them); at .L4 (incsspq reads none, the subq and cmpq
+   before the ja write them).
+
+   Without __RR_SOFTTICKS__, RR_SOFTTICK is empty and the objects are byte-identical to the
+   unpatched ones, debug info included: the ticks are on the line of the instruction they
+   follow or precede, and this file is included from a line that was blank, so no line
+   moves.  The tick sequence ends at the local label 7731, which nothing else here uses.
+   Only x86-64 is ticked: the i386 code paths would build without ticks, so a ticked i386
+   build is an error.  */
+
+#ifndef RR_SOFTTICKS_ASM_H
+#define RR_SOFTTICKS_ASM_H
+
+#if defined(__RR_SOFTTICKS__)
+# if __RR_SOFTTICKS__ != 1
+#  error "unsupported rr software ticks ABI version"
+# endif
+# if !defined(__x86_64__)
+#  error "rr software ticks: only libitm's x86-64 assembly has them"
+# endif
+/* The byte-exact x86-64 RR_SOFTTICKS_X64_TICK_ASM.  */
+# define RR_SOFTTICK testb $0x80, 0x70001807; jnz 7731f; decq 0x70001800; jnz 7731f; int3; 7731:
+#else
+# define RR_SOFTTICK
+#endif
+
+#endif /* RR_SOFTTICKS_ASM_H */
