rr software ticks (rr's include/rr/softticks.h, ABI version 1) for the hand-written x86-64
assembly of GCC 14.2's runtime libraries, which the compiler plugin does not see:

- libitm/config/x86/sjlj.S: _ITM_beginTransaction ticks at its entry and before
  `jmp .Lhtm_fastpath`, the HTM retry's back edge (both outside the xbegin region, where an
  RTM abort would roll a tick back); GTM_longjmp at its entry and at .L4, the head of its
  loop over the shadow stack (CET).
- libgcc/config/i386/morestack.S (-fsplit-stack): __morestack_non_split, __morestack,
  __morestack_large_model, __stack_split_initialize and __morestack_{get,set,make}_guard tick
  at their entry. And the plugin's page-mapping initializer runs first in morestack.S's
  .init_array.00000 (priority 0, before the initializer's own priority 1): without it,
  __stack_split_initialize and the C function it calls tick before anything has mapped the
  countdown's page, and a split-stack program crashes at startup outside rr (unless another
  instrumented library, or a C library that maps the page, initialized first).
- libgcc/config/i386/{sav,res}ms64*.h (-mcall-ms2sysv-xlogues stubs, {sse,avx}_*.S): one
  tick in front of each file's shared exit, which every entry falls through to. The sav and
  plain res stubs keep the flags around it (pushfq/popfq): GCC emits their calls as insns
  that do not clobber the flags, and keeps a comparison's flags live across them.

The tick clobbers the flags only, which are dead at every other one of these places. A no-op
unless the compiler predefines __RR_SOFTTICKS__ (the software ticks plugin does, also for
.S files): without it the objects are byte-identical, debug info included (no line moves).
A __RR_SOFTTICKS__ other than 1 is an error, as is a ticked build for i386 or x32, whose
code paths have no ticks. See libgcc/config/i386/rr-softticks.h and
libitm/config/x86/rr-softticks.h.

--- a/libgcc/config/i386/rr-softticks.h
+++ b/libgcc/config/i386/rr-softticks.h
@@ -0,0 +1,91 @@
+/* rr software ticks (rr's include/rr/softticks.h, ABI version 1) for libgcc's x86-64
+   assembly: morestack.S (-fsplit-stack) and the -mcall-ms2sysv-xlogues register save and
+   restore stubs ({sse,avx}_{sav,res}ms64*.S, through i386-asm.h).
+
+   Code built for rr's software-ticks mode counts its own progress: no instruction may run
+   twice at the same (pc, sp) without a tick in between.  The compiler plugin ticks compiled
+   code and predefines __RR_SOFTTICKS__ (the ABI version) for .S files too; this assembly is
+   ticked by hand.  None of it has a loop, but a function called twice from one frame runs
+   its first instructions at the same (pc, sp) twice, so each function ticks on every path
+   from its entry (RR_SOFTTICK):
+   - morestack.S: __morestack_non_split, __morestack, __morestack_large_model,
+     __stack_split_initialize and __morestack_{get,set,make}_guard, at their entry (after
+     the CFI that their first instruction has, so that the unwind info stays right);
+   - the stubs: each file's entry points fall through to one shared exit, which ticks just
+     before it (the ret; in the x variants, which return from their caller, the mov to %rsp
+     or the leave).
+   A tick clobbers the arithmetic flags and nothing else: no register, no stack.  The flags
+   are dead at morestack.S's entries (the split-stack prologue's call to __morestack, which
+   is a call insn, and plain calls from C).  They are not dead across the save and restore
+   stubs: GCC emits a call of one as an insn that only saves or restores registers through
+   %rax or %rsi (ix86_emit_outlined_ms2sysv_save/restore: no clobber of the flags), so it
+   may compare before the call and branch after it (gcc.target/x86_64/abi/ms-sysv's
+   shrink-wrapped functions do, around the save).  So the sav and the plain res stubs keep
+   the flags around their tick (RR_SOFTTICK_KEEP_FLAGS: pushfq and popfq, below the stack
+   pointer; their callers are ms_abi functions, which have no red zone).  The x variants
+   return from their caller, after which the flags are dead.
+
+   Ticks read the countdown's page, which outside rr each instrumented module's initializer
+   (__rr_softticks_init, from .init_array at priority 1) maps.  morestack.S's constructors
+   run at priority 0, before it: __stack_split_initialize ticks, and so does the C function
+   it calls, so a split-stack program whose page no module had mapped yet (no other
+   instrumented library loaded before it, a C library that does not map it) faulted at
+   startup.  RR_SOFTTICKS_INIT_FIRST, in morestack.S's .init_array.00000 ahead of
+   __stack_split_initialize, runs that initializer first (the ABI's code, in its COMDAT group
+   with its own .init_array entry and the note, as the plugin emits it: the linker keeps one
+   of the identical groups).  Mapping the page a second time fails with EEXIST, as under rr,
+   which the initializer ignores.
+
+   Without __RR_SOFTTICKS__ the macros are empty and the objects are byte-identical to the
+   unpatched ones, debug info included: the macros are on lines of their own that were blank
+   or on the line of the instruction they precede, and morestack.S includes this file from a
+   line that was blank (i386-asm.h makes no code), so no line moves.  The tick ends at the
+   local label 7731 and the initializer's exit is 7732, which nothing else here uses.  Only
+   x86-64 (LP64) is ticked: the i386 code paths would build without ticks, so a ticked i386 (or
+   x32) build is an error.  */
+
+#ifndef RR_SOFTTICKS_ASM_H
+#define RR_SOFTTICKS_ASM_H
+
+#if defined(__RR_SOFTTICKS__)
+# if __RR_SOFTTICKS__ != 1
+#  error "unsupported rr software ticks ABI version"
+# endif
+# if !defined(__x86_64__) || !defined(__LP64__)
+#  error "rr software ticks: only libgcc's x86-64 (LP64) assembly has them"
+# endif
+/* The byte-exact x86-64 RR_SOFTTICKS_X64_TICK_ASM.  */
+# define RR_SOFTTICK testb $0x80, 0x70001807; jnz 7731f; decq 0x70001800; jnz 7731f; int3; 7731:
+/* A tick that keeps the flags (all of EFLAGS, which popfq restores as they were).  */
+# define RR_SOFTTICK_KEEP_FLAGS pushfq; RR_SOFTTICK; popfq
+/* RR_SOFTTICKS_X64_INIT_ASM (with RR_SOFTTICKS_INIT_SYMBOL, RR_SOFTTICKS_INIT_PRIORITY,
+   RR_SOFTTICKS_MMAP_FLAGS and the note), and an entry for it in the current section.  */
+# if defined(HAVE_INITFINI_ARRAY_SUPPORT) && HAVE_INITFINI_ARRAY_SUPPORT
+#  define RR_SOFTTICKS_INIT_FIRST \
+	.quad __rr_softticks_init; \
+	.pushsection .text.__rr_softticks_init,"axG",@progbits,__rr_softticks_init,comdat; \
+	.weak __rr_softticks_init; .hidden __rr_softticks_init; \
+	.type __rr_softticks_init,%function; .p2align 4; \
+__rr_softticks_init: \
+	movl $9, %eax; movl $0x70001000, %edi; movl $4096, %esi; movl $3, %edx; \
+	movl $0x100022, %r10d; movq $-1, %r8; xorl %r9d, %r9d; syscall; \
+	cmpq $0x70001000, %rax; je 7732f; cmpq $-4095, %rax; jae 7732f; \
+	movq %rax, %rdi; movl $11, %eax; movl $4096, %esi; syscall; \
+7732:	ret; \
+	.size __rr_softticks_init,.-__rr_softticks_init; \
+	.section .init_array.00001,"awG",@init_array,__rr_softticks_init,comdat; \
+	.p2align 3; .quad __rr_softticks_init; \
+	.section .note.rrsoftticks,"aG",@note,__rr_softticks_init,comdat; \
+	.p2align 2; .long 3; .long 4; .long 1; .asciz "rr"; .p2align 2; .long 1; \
+	.popsection
+# else
+/* (.ctors would run it last) */
+#  define RR_SOFTTICKS_INIT_FIRST .error "rr software ticks: morestack.S needs .init_array"
+# endif
+#else
+# define RR_SOFTTICK
+# define RR_SOFTTICK_KEEP_FLAGS
+# define RR_SOFTTICKS_INIT_FIRST
+#endif
+
+#endif /* RR_SOFTTICKS_ASM_H */
