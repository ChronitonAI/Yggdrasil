diff --git a/sysdeps/x86_64/start.S b/sysdeps/x86_64/start.S
--- a/sysdeps/x86_64/start.S
+++ b/sysdeps/x86_64/start.S
@@ -54,6 +54,11 @@
 
 #include <sysdep.h>
 
+/* rr software ticks: _start must not tick before it has mapped the
+   countdown's page (see RR_SOFTTICK in sysdep.h).  */
+#undef RR_SOFTTICK_ENTRY
+#define RR_SOFTTICK_ENTRY
+
 ENTRY (_start)
 	/* Clearing frame pointer is insufficient, use CFI.  */
 	cfi_undefined (rip)
diff --git a/sysdeps/x86_64/sysdep.h b/sysdeps/x86_64/sysdep.h
--- a/sysdeps/x86_64/sysdep.h
+++ b/sysdeps/x86_64/sysdep.h
@@ -58,6 +58,48 @@ enum cf_protection_level
 # define _CET_NOTRACK
 #endif
 
+/* rr software ticks (rr's tracee ABI version 1, include/rr/softticks.h in
+   rr).  A compiler built for them predefines __RR_SOFTTICKS__ and ticks the
+   code it compiles, so that no instruction runs twice at the same pc and
+   stack pointer without a tick in between: at the entry of every function
+   and once on every way round each loop.  The assembly does so by hand:
+   ENTRY ticks (RR_SOFTTICK_ENTRY), the functions defined without it tick
+   where they start, and every loop ticks with RR_SOFTTICK (or one of the
+   variants below) on each iteration.
+
+   RR_SOFTTICK is the ABI's x86-64 tick sequence, exactly: rr recognizes a
+   tick by its bytes.  It tests the top bit of the countdown at 0x70001800,
+   which is set (the countdown is disarmed) whenever rr does not arm it, and
+   only then decrements the countdown and traps (int3) when that reaches 0.
+   The dynamic loader and the static programs' _start map the countdown's
+   page before anything ticks.  The tick clobbers the arithmetic flags and
+   nothing else, so it goes where no flag is live; the numeric label 7731 is
+   local to it.  RR_SOFTTICK_CF (r8) is a tick where only CF is live and the
+   8-bit register r8 is dead: r8 keeps CF across the tick (setc, and 0xff
+   plus 0 or 1 carries iff CF was set).  Without __RR_SOFTTICKS__ they are
+   empty, and the object code is the same as without them.  */
+#ifdef __RR_SOFTTICKS__
+# define RR_SOFTTICK							      \
+	testb $0x80, 0x70001807;					      \
+	jnz 7731f;							      \
+	decq 0x70001800;						      \
+	jnz 7731f;							      \
+	int3;								      \
+7731:
+# define RR_SOFTTICK_CF(r8)						      \
+	setc r8;							      \
+	RR_SOFTTICK;							      \
+	addb $-1, r8
+#else
+# define RR_SOFTTICK
+# define RR_SOFTTICK_CF(r8)
+#endif
+
+/* The tick at the entry of every function that ENTRY defines.  A file whose
+   function must not tick there (_start, which runs before the countdown's
+   page is mapped) redefines it as empty before ENTRY.  */
+#define RR_SOFTTICK_ENTRY RR_SOFTTICK
+
 /* Define an entry point visible from C.  */
 #define	ENTRY_P2ALIGN(name, alignment)					      \
   .globl C_SYMBOL_NAME(name);						      \
@@ -66,6 +108,7 @@ enum cf_protection_level
   C_LABEL(name)								      \
   cfi_startproc;							      \
   _CET_ENDBR;								      \
+  RR_SOFTTICK_ENTRY;							      \
   CALL_MCOUNT
 
 /* This macro is for setting proper CFI with DW_CFA_expression describing
diff --git a/sysdeps/x86_64/dl-machine.h b/sysdeps/x86_64/dl-machine.h
--- a/sysdeps/x86_64/dl-machine.h
+++ b/sysdeps/x86_64/dl-machine.h
