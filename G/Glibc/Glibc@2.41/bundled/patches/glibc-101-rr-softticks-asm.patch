diff --git a/sysdeps/x86_64/add_n.S b/sysdeps/x86_64/add_n.S
--- a/sysdeps/x86_64/add_n.S
+++ b/sysdeps/x86_64/add_n.S
@@ -96,5 +96,11 @@ L(e10):
 L(e01):
 	jrcxz	L(end)
 	lea	4(n), n
+	/* rr software ticks: CF (the carry) is live round the loop and
+	   %rax is dead in it.  Every iteration takes the jmp back (the loop
+	   is entered at L(e00), L(e11), L(e10) or L(e01) and left by the
+	   jrcxz), and a tick here does not lengthen the jrcxz's reach back
+	   to L(end).  */
+	RR_SOFTTICK_CF (%al)
 	jmp	L(top)
 END (func)
