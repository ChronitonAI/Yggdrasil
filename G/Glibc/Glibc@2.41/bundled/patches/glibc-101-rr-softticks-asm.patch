 	# Save the user entry point address in %r12.\n\
 	mov %" RAX_LP ", %" R12_LP "\n\
 	# Save %rsp value in %r13.\n\
@@ -772,3 +772,21 @@ x86_64_dynamic_after_reloc (struct link_map *map, int lazy)
   x86_64_rewrite_plt_in_place (map);
 }
 #endif
+
+/* rr software ticks (see RR_SOFTTICK in sysdep.h): _dl_start_user in
+   RTLD_START ticks at its start like every assembled function (_start, which
+   runs before the countdown's page is mapped, does not).  At the end of the
+   file, so that the lines of the asserts above stay where they were.  */
+#ifndef RTLD_START_SOFTTICK
+# ifdef __RR_SOFTTICKS__
+#  define RTLD_START_SOFTTICK "\
+	testb $0x80, 0x70001807\n\
+	jnz 7731f\n\
+	decq 0x70001800\n\
+	jnz 7731f\n\
+	int3\n\
+7731:\n"
+# else
+#  define RTLD_START_SOFTTICK ""
+# endif
+#endif
